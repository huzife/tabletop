# Tabletop production environment template.
# provision-server.sh copies this file to /etc/tabletop/tabletop.env once and
# replaces the placeholder below with a locally generated random secret.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/var/lib/tabletop/tabletop.db
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SECURE=false
TRUST_PROXY=loopback
LOG_LEVEL=info
GAME_AI_WORKERS=1
