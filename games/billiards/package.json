{
  "name": "@tabletop/game-billiards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./shared/index.ts",
      "development": "./shared/index.ts",
      "import": "./dist/shared/index.js"
    },
    "./server": {
      "types": "./server/index.ts",
      "development": "./server/index.ts",
      "import": "./dist/server/index.js"
    },
    "./web": {
      "types": "./web/index.ts",
      "development": "./web/index.ts",
      "import": "./dist/web/index.js"
    },
    "./styles.css": "./web/styles.css"
  },
  "files": [
    "dist",
    "native/generated/tabletop_billiards_core.wasm",
    "physics",
    "server",
    "shared",
    "web"
  ],
  "scripts": {
    "build:native": "bash native/build-wasm.sh",
    "prebuild": "npm run build:native && rm -rf dist",
    "build": "tsc -p tsconfig.build.json && cp web/styles.css dist/web/styles.css && cp -R web/assets dist/web/assets",
    "postbuild": "mkdir -p dist/native/generated && cp native/generated/tabletop_billiards_core.wasm dist/native/generated/tabletop_billiards_core.wasm",
    "check:native": "cargo fmt --manifest-path native/Cargo.toml --check && cargo clippy --manifest-path native/Cargo.toml --all-targets -- -D warnings",
    "prepack": "npm run build",
    "pretest": "npm run build:native",
    "test": "npm run test:native && vitest run",
    "test:native": "cargo test --manifest-path native/Cargo.toml",
    "pretest:coverage": "npm run build:native",
    "test:coverage": "npm run test:native && vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tabletop/game-sdk": "workspace:*",
    "@tabletop/protocol": "workspace:*",
    "@tabletop/scene": "workspace:*",
    "@tabletop/ui": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
