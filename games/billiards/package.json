{
  "name": "@tabletop/game-billiards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./shared/index.ts",
      "development": "./shared/index.ts",
      "import": "./dist/shared/index.js"
    },
    "./server": {
      "types": "./server/index.ts",
      "development": "./server/index.ts",
      "import": "./dist/server/index.js"
    },
    "./web": {
      "types": "./web/index.ts",
      "development": "./web/index.ts",
      "import": "./dist/web/index.js"
    },
    "./styles.css": "./web/styles.css"
  },
  "files": [
    "dist",
    "web/styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp web/styles.css dist/web/styles.css",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tabletop/game-sdk": "workspace:*",
    "@tabletop/protocol": "workspace:*",
    "@tabletop/ui": "workspace:*",
    "lucide-react": "catalog:",
    "p2-es": "^1.2.3",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
