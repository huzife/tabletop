{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "types": ["node", "react"]
  },
  "include": ["shared/**/*.ts", "server/**/*.ts", "web/**/*.ts", "web/**/*.tsx"],
  "exclude": ["tests/**/*.ts", "tests/**/*.tsx"]
}
