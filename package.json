{
  "name": "tabletop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm check:architecture && pnpm check:native && pnpm typecheck && pnpm test",
    "check:architecture": "node scripts/check-game-boundaries.mjs",
    "check:native": "pnpm -r --if-present check:native",
    "predev": "pnpm --filter @tabletop/game-billiards build:native",
    "dev": "pnpm --parallel --filter @tabletop/server --filter @tabletop/web dev",
    "dev:scene": "pnpm --filter @tabletop/scene-editor dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:visual": "node apps/web/e2e/desktop-visual-smoke.mjs",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@playwright/test": "catalog:testing",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
